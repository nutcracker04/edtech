admin panel# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_settings

# Database Password (required for migrations)
# Get this from: Supabase Dashboard > Project Settings > Database > Connection String
# Look for the password in the connection string or reset it in Database Settings
SUPABASE_DB_PASSWORD=your_database_password_here

# Storage
STORAGE_BUCKET_TEST_PAPERS=test-papers
STORAGE_BUCKET_RESPONSE_SHEETS=response-sheets

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract  # Update based on your installation
TESSERACT_LANG=eng

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here  # Get from https://console.groq.com

# PDF Extraction Configuration
SARVAM_API_KEY=your_sarvam_api_key_here  # Get from https://www.sarvam.ai/
# Optional PDF extraction settings (defaults shown):
# PDF_EXTRACTION_MAX_PDF_SIZE_MB=100
# PDF_EXTRACTION_STRUCTURE_CONFIDENCE_THRESHOLD=0.7
# PDF_EXTRACTION_LINK_CONFIDENCE_THRESHOLD=0.7
# PDF_EXTRACTION_IMAGE_STORAGE_PATH=backend/data/extracted_images
